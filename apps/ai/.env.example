# ProductiveHix AI runtime (Phase 0)
# Copy to apps/ai/.env or apps/api/.env. Never commit real keys.

# Active local provider for the chat runtime.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b

# Provider credentials. Keep real values only in .env files.
GROQ_API_KEY=
GEMINI_API_KEY=

AI_TEMPERATURE=0.7
AI_DEFAULT_MAX_OUTPUT_TOKENS=4096
AI_MAX_OUTPUT_TOKENS=8192
