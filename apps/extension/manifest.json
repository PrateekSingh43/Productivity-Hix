{
  "manifest_version": 3,
  "name": "ProductiveHix Tracker",
  "version": "0.2.0",
  "description": "First-party productivity and learning analytics extension for ProductiveHix",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "notifications",
    "nativeMessaging",
    "system.display"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:5600/*",
    "http://localhost:5600/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProductiveHix Tracker",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon.png", "icon-128.png", "icon-48.png", "icon-16.png", "popup.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
