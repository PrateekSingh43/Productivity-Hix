# ProductiveHix Worker — local configuration template.
#
# Copy to `.env` and fill in real values (never commit `.env`):
#   cp apps/worker/.env.example apps/worker/.env
#
# Redis resolution is cloud-first with local fallback (see
# `src/runtime/redis.ts`): `REDIS_URL` / the Upstash REST pair are probed
# first, then `REDIS_LOCAL_*` on 127.0.0.1:6379.

# Cloud Redis (Upstash). Leave unset for local-only development.
# Placeholder tokens only — put real credentials in `apps/worker/.env`.
REDIS_URL="rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://YOUR_HOST.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

# Local Redis fallback (used automatically when the cloud is unreachable).
REDIS_LOCAL_URL="redis://127.0.0.1:6379"
REDIS_LOCAL_HOST="127.0.0.1"
REDIS_LOCAL_PORT="6379"
REDIS_PROBE_TIMEOUT_MS="3000"
# Force local Redis even when cloud credentials are set (e.g. Upstash
# free-tier quota exhausted — the probe now detects that, but this skips
# cloud entirely for zero wasted requests).
# REDIS_FORCE_LOCAL="true"

# PostgreSQL connection (required by `@repo/db`). Real credentials belong
# only in `apps/worker/.env`, never in this template.
DATABASE_URL="postgresql://postgres:password@localhost:5432/productivehix"

# Outbox publisher tuning (defaults shown; see `src/bootstrap.ts`).
OUTBOX_POLL_INTERVAL_MS="500"
OUTBOX_BATCH_SIZE="25"

# Phase 2/3 rollout flags (all default off = legacy BullMQ behavior).
# TIMELINE_WORK_DISPATCH=true: ingest writes one work row per (user, day)
#   and the publisher dispatches from timeline_work instead of per-batch
#   outbox rows (40 ticks/min → ~1 execution/min). Rollback: unset.
# TIMELINE_DIRECT_DISPATCH=true: requires TIMELINE_WORK_DISPATCH=true;
#   executes timeline work inline via BaseWorker.run (no Redis/BullMQ).
#   Single-process only (in-memory locks). Rollback: unset.
# TIMELINE_WORK_DISPATCH="false"
# TIMELINE_DIRECT_DISPATCH="false"
