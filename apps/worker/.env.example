# ProductiveHix Worker — local configuration template (Redis-free).
#
# Copy to `.env` and fill in real values (never commit `.env`):
#   cp apps/worker/.env.example apps/worker/.env
#
# The worker is Postgres-direct: timeline_work rows + outbox events are
# claimed with leased Postgres rows and executed via TimelineWorker /
# PatternWorker in-process. There is no Redis, no BullMQ, no Upstash
# dependency — nothing to configure for queueing.

# PostgreSQL connection (required by `@repo/db`). Real credentials belong
# only in `apps/worker/.env`, never in this template.
DATABASE_URL="postgresql://postgres:password@localhost:5432/productivehix"

# Outbox publisher tuning (defaults shown; see `src/bootstrap.ts`).
OUTBOX_POLL_INTERVAL_MS="500"
OUTBOX_BATCH_SIZE="25"
