{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts | pino-pretty",
    "build": "tsup",
    "start": "node -r dotenv/config dist/index.js",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "test:e2e": "tsx test_e2e_proof.ts",
    "lint": "eslint . --max-warnings 0",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@repo/analytics": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/db": "workspace:^",
    "@repo/telemetry": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/validation": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "17.2.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "pino": "10.0.0",
    "pino-http": "11.0.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "@types/ws": "^8.5.14",
    "eslint": "10.9.1",
    "pino-pretty": "13.1.1",
    "rimraf": "6.0.1",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
