# Desktop Bridge Local Configuration

# Port where ActivityWatch is running locally
ACTIVITYWATCH_BASE_URL="http://127.0.0.1:5600"

# ProductiveHix API endpoint for batch ingestion
PRODUCTIVEHIX_API_URL="http://localhost:4000"

# Development user ID for testing bypassing OAuth (must match API dev UUID)
DEV_USER_ID="00000000-0000-0000-0000-000000000001"

# Sync interval in milliseconds
SYNC_INTERVAL_MS="1500"
